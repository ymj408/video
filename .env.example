# Demo-only defaults. Replace these values for any shared environment.
MYSQL_DATABASE=luma_studio
MYSQL_USER=luma
MYSQL_PASSWORD=luma_secret
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_PORT=3306

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Runtime simulation defaults (can also be changed via PUT /api/dev/simulation)
SIMULATION_STEP_DELAY_MS=2500
SIMULATION_FAIL_STAGE=NONE
SIMULATION_FAIL_NEXT_ONLY=true
SIMULATION_CONTROL_ENABLED=true

# Background executor sizing
JOB_CORE_POOL_SIZE=2
JOB_MAX_POOL_SIZE=4
JOB_QUEUE_CAPACITY=100

# Unfinished jobs are failed with a reason on restart because resume is out of scope.
FAIL_UNFINISHED_ON_STARTUP=true
